{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    8
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 250
      },
      "min": 44,
      "max": 480,
      "background": "canvas",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          },
          "border": {
            "width": 2,
            "color": "border"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              },
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              },
              "border": {
                "width": 2,
                "color": "border"
              }
            }
          ],
          "gap": 10
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "border": {
            "width": 2,
            "color": "border"
          }
        }
      ],
      "gap": 10
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs-files"
          },
          "border": {
            "width": 2,
            "color": "border"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 0,
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 0,
                  "background": "#1e1e2eeb",
                  "lone": true,
                  "border": {
                    "width": 2,
                    "color": "border"
                  },
                  "focus": {
                    "width": 2,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 420
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files-square"
                      }
                    }
                  ]
                }
              ],
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          },
          "border": {
            "width": 2,
            "color": "border"
          }
        }
      ],
      "gap": 10
    }
  ],
  "theme": "catppuccin-mocha",
  "font": "Summer Ghost",
  "font_size": 16,
  "ui_font": "Summer Ghost",
  "padding": 10,
  "gap": 10,
  "window_blur": true,
  "terminal_opacity": 0
}
